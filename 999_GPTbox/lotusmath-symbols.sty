\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lotusmath-symbols}[2026/10/19 lotusmath symbols]
\RequirePackage{environ}
\RequirePackage{amssymb}
\RequirePackage{amsmath}

\makeatletter
%数学関連マクロ

%式番号
\newcommand{\EqNo}[1]{\textcircled{\scriptsize #1}}

% 条件番号。既存の式番号の字形を使い、本文・数式の両方に対応する。
% 番号は手動指定で、自動採番やカウンタの更新は行わない。
\DeclareRobustCommand{\CondNo}[1]{%
  \ifmmode
    \text{\normalfont\EqNo{#1}}%
  \else
    \mbox{\normalfont\EqNo{#1}}%
  \fi
}

% 式番号つきの式
\newlength{\EqItemWidth}
\setlength{\EqItemWidth}{25mm}
\newcommand{\SetEqItemWidth}[1]{\setlength{\EqItemWidth}{#1}}
\newcommand{\EqItem}[2]{\makebox[\EqItemWidth][l]{\EqNo{#1}\hspace{0.4em}$#2$}}

% 式一覧の行間
\newcommand{\EqListArrayStretch}{1.6}
\newcommand{\SetEqListArrayStretch}[1]{\renewcommand{\EqListArrayStretch}{#1}}

% 式一覧の直前余白
\newcommand{\LMPrepareEqList}{%
  \par
  \ifLMAfterTypeQuestion
    \vspace{-6mm}%
  \else
    \vspace{-2mm}%
  \fi
  \LMAfterTypeQuestionfalse
}

% 式一覧：横3列
\NewEnviron{EqListThree}{%
  \ifLMAnswerMode
  \else
    \LMPrepareEqList
    \begingroup
    \renewcommand{\arraystretch}{\EqListArrayStretch}%
    \noindent\hspace*{\fill}%
    \begin{tabular*}{0.72\linewidth}{@{\extracolsep{\fill}}lll@{}}
      \BODY
    \end{tabular*}%
    \hspace*{\fill}\par
    \vspace{6mm}
    \endgroup
  \fi
}

% 式一覧：横2列
\NewEnviron{EqListTwo}{%
  \ifLMAnswerMode
  \else
    \LMPrepareEqList
    \begingroup
    \renewcommand{\arraystretch}{\EqListArrayStretch}%
    \noindent\hspace*{\fill}%
    \begin{tabular*}{0.50\linewidth}{@{\extracolsep{\fill}}ll@{}}
      \BODY
    \end{tabular*}%
    \hspace*{\fill}\par
    \vspace{6mm}
    \endgroup
  \fi
}

%パーセント
\newcommand{\percent}{％ }

%%三角形
\newcommand{\Tri}[1]{
{\triangle \rm #1}
}

\newcommand{\Ang}[1]{
{\angle \rm #1}
}
%線分
\newcommand{\Lseg}[1]{
{\rm #1}
}

% 平行（右上がりの斜線2本）
\newcommand{\Parallel}{\mathrel{/\!/}}

% 相似（両端が丸まった日本式の字形）。通常の \sim は変更しない。
% 和文フォントの字形を使い、\text で添字内でも文字サイズを追従させる。
\newcommand{\Similar}{\mathrel{\text{∽}}}
\makeatother
