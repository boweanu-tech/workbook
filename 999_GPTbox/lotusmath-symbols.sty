\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lotusmath-symbols}[2026/07/08 lotusmath symbols]

\makeatletter
%数学関連マクロ

%式番号
\newcommand{\EqNo}[1]{\textcircled{\scriptsize #1}}

% 式番号つきの式
\newcommand{\EqItem}[2]{\EqNo{#1}\ $#2$}

% 式一覧：横3列
\newenvironment{EqListThree}{%
  \par\smallskip
  \begin{center}
  \begin{tabular*}{0.72\linewidth}{@{\extracolsep{\fill}}ccc@{}}
}{%
  \end{tabular*}
  \end{center}
  \vspace{1mm}
}

% 式一覧：横2列
\newenvironment{EqListTwo}{%
  \par\smallskip
  \begin{center}
  \begin{tabular*}{0.50\linewidth}{@{\extracolsep{\fill}}cc@{}}
}{%
  \end{tabular*}
  \end{center}
  \vspace{1mm}
}

%パーセント
\newcommand{\percent}{％ }

%%三角形
\newcommand{\Tri}[1]{
{\triangle \rm #1}
}

\newcommand{\Ang}[1]{
{\angle \rm #1}
}
%線分
\newcommand{\Lseg}[1]{
{\rm #1}
}
\makeatother