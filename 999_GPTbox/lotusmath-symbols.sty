\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lotusmath-symbols}[2026/07/08 lotusmath symbols]
\RequirePackage{environ}

\makeatletter
%数学関連マクロ

%式番号
\newcommand{\EqNo}[1]{\textcircled{\scriptsize #1}}

% 式番号つきの式
\newlength{\EqItemWidth}
\setlength{\EqItemWidth}{25mm}
\newcommand{\SetEqItemWidth}[1]{\setlength{\EqItemWidth}{#1}}
\newcommand{\EqItem}[2]{\makebox[\EqItemWidth][l]{\EqNo{#1}\hspace{0.4em}$#2$}}

% 式一覧の行間
\newcommand{\EqListArrayStretch}{1.6}
\newcommand{\SetEqListArrayStretch}[1]{\renewcommand{\EqListArrayStretch}{#1}}

% 式一覧の直前余白
\newcommand{\LMPrepareEqList}{%
  \par
  \ifLMAfterTypeQuestion
    \vspace{-6mm}%
  \else
    \smallskip
  \fi
  \LMAfterTypeQuestionfalse
}

% 式一覧：横3列
\NewEnviron{EqListThree}{%
  \ifLMAnswerMode
  \else
    \LMPrepareEqList
    \begingroup
    \renewcommand{\arraystretch}{\EqListArrayStretch}%
    \noindent\hspace*{\fill}%
    \begin{tabular*}{0.72\linewidth}{@{\extracolsep{\fill}}lll@{}}
      \BODY
    \end{tabular*}%
    \hspace*{\fill}\par
    \vspace{6mm}
    \endgroup
  \fi
}

% 式一覧：横2列
\NewEnviron{EqListTwo}{%
  \ifLMAnswerMode
  \else
    \LMPrepareEqList
    \begingroup
    \renewcommand{\arraystretch}{\EqListArrayStretch}%
    \noindent\hspace*{\fill}%
    \begin{tabular*}{0.50\linewidth}{@{\extracolsep{\fill}}ll@{}}
      \BODY
    \end{tabular*}%
    \hspace*{\fill}\par
    \vspace{6mm}
    \endgroup
  \fi
}

%パーセント
\newcommand{\percent}{％ }

%%三角形
\newcommand{\Tri}[1]{
{\triangle \rm #1}
}

\newcommand{\Ang}[1]{
{\angle \rm #1}
}
%線分
\newcommand{\Lseg}[1]{
{\rm #1}
}
\makeatother
