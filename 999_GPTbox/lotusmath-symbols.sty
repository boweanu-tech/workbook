\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lotusmath-symbols}[2026/07/08 lotusmath symbols]

\makeatletter
%数学関連マクロ

%式番号
\newcommand{\EqNo}[1]{\textcircled{\scriptsize #1}}

% 式番号つきの式
\newlength{\EqItemWidth}
\setlength{\EqItemWidth}{25mm}
\newcommand{\SetEqItemWidth}[1]{\setlength{\EqItemWidth}{#1}}
\newcommand{\EqItem}[2]{\makebox[\EqItemWidth][l]{\EqNo{#1}\hspace{0.4em}$#2$}}

% 式一覧の行間
\newcommand{\EqListArrayStretch}{1.6}
\newcommand{\SetEqListArrayStretch}[1]{\renewcommand{\EqListArrayStretch}{#1}}

% 式一覧：横3列
\newenvironment{EqListThree}{%
  \par\smallskip
  \begingroup
  \renewcommand{\arraystretch}{\EqListArrayStretch}
  \begin{center}
  \begin{tabular*}{0.72\linewidth}{@{\extracolsep{\fill}}lll@{}}
}{%
  \end{tabular*}
  \end{center}
  \vspace{4mm}
  \endgroup
}

% 式一覧：横2列
\newenvironment{EqListTwo}{%
  \par\smallskip
  \begingroup
  \renewcommand{\arraystretch}{\EqListArrayStretch}
  \begin{center}
  \begin{tabular*}{0.50\linewidth}{@{\extracolsep{\fill}}ll@{}}
}{%
  \end{tabular*}
  \end{center}
  \vspace{4mm}
  \endgroup
}

%パーセント
\newcommand{\percent}{％ }

%%三角形
\newcommand{\Tri}[1]{
{\triangle \rm #1}
}

\newcommand{\Ang}[1]{
{\angle \rm #1}
}
%線分
\newcommand{\Lseg}[1]{
{\rm #1}
}
\makeatother