%数学関連マクロ

%式番号
\newcommand{\EqNo}[1]{\textcircled{\scriptsize #1}}

% 式番号つきの式
\newcommand{\EqItem}[2]{\EqNo{#1}\ $#2$}

% 式一覧：横3列
\newenvironment{EqListThree}{%
  \par\smallskip
  \noindent\begin{tabular}{lll}
}{%
  \end{tabular}
  \par\smallskip
}

% 式一覧：横2列
\newenvironment{EqListTwo}{%
  \par\smallskip
  \noindent\begin{tabular}{ll}
}{%
  \end{tabular}
  \par\smallskip
}

%パーセント
\newcommand{\percent}{％ }

%%三角形
\newcommand{\Tri}[1]{
{\triangle \rm #1}
}

\newcommand{\Ang}[1]{
{\angle \rm #1}
}
%線分
\newcommand{\Lseg}[1]{
{\rm #1}
}
\makeatother
