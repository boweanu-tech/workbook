\newcommand{\CoverPage}[2]{%
  \gdef\LMCoverTitle{#1}%
  \gdef\LMCoverSubtitle{#2}%
  \begin{titlepage}
  \thispagestyle{empty}
  \vspace*{20mm}
  {\large 名前\quad\underline{\hspace{80mm}}}\par
  \vspace{35mm}
  \begin{center}
    {\Huge 総まとめテスト}\par
    \vspace{12mm}
    {\LARGE #1}\par
    \vspace{18mm}
    {\large #2}\par
  \end{center}
  \end{titlepage}
}

\newcommand{\CoverPageLesson}[3]{%
  \gdef\LMCoverTitle{#1}%
  \gdef\LMCoverSubtitle{#2}%
  \begin{titlepage}
  \thispagestyle{empty}
  \vspace*{20mm}
  {\large 名前\quad\underline{\hspace{80mm}}}\par
  \vspace{35mm}
  \begin{center}
    {\Huge #1}\par
    \vspace{12mm}
    {\LARGE #2}\par
    \vspace{18mm}
    {\large #3}\par
  \end{center}
  \end{titlepage}
  \clearpage
  \null
  \thispagestyle{empty}%
  \clearpage
}

\newcommand{\LMPrintedMajor}{\LMCurrentTheme}
\newcommand{\LMBoxedMajor}{%
  {\setlength{\fboxsep}{0pt}%
   \fcolorbox{black}{LMBoxGray}{\parbox[c][8mm][c]{8mm}{\centering\large\LMPrintedMajor}}}%
}

\newcommand{\LMBoxedMajorLesson}{%
  {\setlength{\fboxsep}{0pt}%
   \fcolorbox{black}{LMBoxGray}{\parbox[c][10mm][c]{10mm}{\centering\Large\LMPrintedMajor}}}%
}

\newcommand{\LMBoxedTypeQuestion}{%
  {\setlength{\fboxsep}{0pt}%
   \fbox{\parbox[c][8mm][c]{8mm}{\centering\Large\theLMtype}}}%
}

\newcommand{\LMBoxedTypeQuestionAns}{%
  {\setlength{\fboxsep}{0pt}%
   \fbox{\parbox[c][5mm][c]{5mm}{\centering\small\theLMtype}}}%
}

\newcommand{\ResetRowSpace}{%
  \setlength{\LMRowSpace}{\LMDefaultRowSpace}%
  \setlength{\LMAnswerRowSpace}{\LMDefaultAnswerRowSpace}%
}

\newcommand{\MajorQuestionLesson}[1]{%
  \ResetRowSpace
  \LMAfterTypeQuestionfalse
  \stepcounter{LMmajor}%
  \setcounter{LMtype}{0}%
  \setcounter{LMsubq}{0}%
  \LMInstructionUsedfalse
  \LMWrapModefalse
  \ifLMAnswerMode
    \ifLMInAnswerBlock\end{minipage}\par\vspace{2mm}\fi
    \noindent\begin{minipage}{\linewidth}
    \LMInAnswerBlocktrue
    \noindent\LMBoxedMajor\par\vspace{1.5mm}%
  \else
    \clearpage
    \noindent\LMBoxedMajorLesson\quad \raisebox{-1mm}{\Large #1}\par
    \vspace{2mm}\hrule height \LMRuleWidth\vspace{4mm}%
  \fi
}

\newcommand{\MajorQuestion}[1]{%
  \ResetRowSpace
  \LMAfterTypeQuestionfalse
  \stepcounter{LMmajor}%
  \setcounter{LMtype}{0}%
  \setcounter{LMsubq}{0}%
  \LMInstructionUsedfalse
  \LMWrapModefalse
  \ifLMAnswerMode
    \ifLMInAnswerBlock\end{minipage}\par\vspace{2mm}\fi
    \noindent\begin{minipage}{\linewidth}
    \LMInAnswerBlocktrue
    \noindent\LMBoxedMajor\par\vspace{1.5mm}%
  \else
    \clearpage
    \noindent\LMBoxedMajor\quad \raisebox{-0.4mm}{#1}\par
    \vspace{2mm}\hrule height \LMRuleWidth\vspace{4mm}%
  \fi
}

% 見出し内では、\vec の矢印を表示したまま高さの計算から除外する。
% これにより、ベクトル記号の有無で説明文の中央位置がずれるのを防ぐ。
\newcommand{\LMTypeQuestionText}[1]{%
  \begingroup
    \let\LMOriginalVec\vec
    \def\vec##1{\mathord{\vphantom{##1}\smash{\LMOriginalVec{##1}}}}%
    #1%
  \endgroup
}

% lesson_用の大問見出し。呼び出すたびに大問番号を進め、小問番号を(1)からに戻す。
% 番号枠と説明文は、それぞれの内容全体の中央でそろえる。
% 例: \TypeQuestion{平方根の形にしなさい。}{rewrite_as_radical}
\newcommand{\TypeQuestion}[2]{%
  \LMAfterTypeQuestionfalse
  \stepcounter{LMtype}%
  \setcounter{LMsubq}{0}%
  \ifLMInstructionUsed
    \par\vspace{\LMTypeQuestionTopSpace}%
  \fi
  \LMInstructionUsedtrue
  \ifLMAnswerMode
    \noindent
    \begin{minipage}[t]{10mm}%
      \vspace{0pt}\LMBoxedTypeQuestionAns%
    \end{minipage}%
    \par\vspace{4mm}%
  \else
    \noindent
    \begin{minipage}[c]{10mm}%
      \LMBoxedTypeQuestion%
    \end{minipage}%
    \hspace{2mm}%
    \begin{minipage}[c]{\dimexpr\linewidth-12mm\relax}%
      \LMTypeQuestionText{#1}%
    \end{minipage}%
    \par
    \vspace{6mm}%
    \LMAfterTypeQuestiontrue
  \fi
}

% 旧記法との互換用。新規ファイルでは \TypeQuestion を用いる。
\newcommand{\TypeQuestionSingle}[2]{\TypeQuestion{#1}{#2}}
\newcommand{\TypeQuestionDouble}[2]{\TypeQuestion{#1}{#2}}

\newcommand{\LessonPageBreak}{%
  \LMAfterTypeQuestionfalse
  \ifLMAnswerMode
    \ifLMInAnswerBlock
      \end{minipage}\par
      \LMInAnswerBlockfalse
      \columnbreak
      \noindent\begin{minipage}{\linewidth}
      \LMInAnswerBlocktrue
    \else
      \columnbreak
    \fi
  \else
    \clearpage
  \fi
}

\newcommand{\LessonQuestionBreak}{%
  \LMAfterTypeQuestionfalse
  \ifLMAnswerMode
  \else
    \clearpage
  \fi
}

\newcommand{\MakeEvenPage}{%
  \LMAfterTypeQuestionfalse
  \clearpage
  \ifodd\value{page}%
    \null\thispagestyle{empty}\clearpage
  \fi
}
