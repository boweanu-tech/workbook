\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lotusmath-english}[2026/10/12 lotusmath English workbook]

\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{needspace}

\makeatletter

% ===== 英語問題の基本部品 =====

\newlength{\LMEngWritingLineHeight}
\setlength{\LMEngWritingLineHeight}{7mm}
\newlength{\LMEngAnswerLineHeight}
\setlength{\LMEngAnswerLineHeight}{5mm}
\newlength{\LMEngRuledTopSpace}
\setlength{\LMEngRuledTopSpace}{2.5mm}
\newlength{\LMEngRuledBottomSpace}
\setlength{\LMEngRuledBottomSpace}{3mm}
\newlength{\LMEngGuideRuleThickness}
\setlength{\LMEngGuideRuleThickness}{0.25pt}
\newlength{\LMEngBaseRuleThickness}
\setlength{\LMEngBaseRuleThickness}{0.45pt}
\newlength{\LMEngSplitGap}
\setlength{\LMEngSplitGap}{7mm}

% gray は 0 が黒、1 が白。3本目の基線だけを濃くする。
\definecolor{LMEngGuideLight}{gray}{0.80}
\definecolor{LMEngGuideBase}{gray}{0.60}

\newcommand{\SetEngWritingLineHeight}[1]{%
  \setlength{\LMEngWritingLineHeight}{#1}%
}

\newcommand{\SetEngAnswerLineHeight}[1]{%
  \setlength{\LMEngAnswerLineHeight}{#1}%
}

\newcommand{\SetEngRuledOuterSpace}[2]{%
  \setlength{\LMEngRuledTopSpace}{#1}%
  \setlength{\LMEngRuledBottomSpace}{#2}%
}

\newcommand{\SetEngRuledLineGray}[2]{%
  \definecolor{LMEngGuideLight}{gray}{#1}%
  \definecolor{LMEngGuideBase}{gray}{#2}%
}

\newcommand{\SetEngRuledLineThickness}[2]{%
  \setlength{\LMEngGuideRuleThickness}{#1}%
  \setlength{\LMEngBaseRuleThickness}{#2}%
}

\newcommand{\SetEngSplitGap}[1]{%
  \setlength{\LMEngSplitGap}{#1}%
}

% 英文の書体。初期値は従来のローマン体。
\newcommand{\LMEngTextFont}{\rmfamily}
\newcommand{\SetEngFont}[1]{\renewcommand{\LMEngTextFont}{#1}}
% andika.sty を読み込んだ親TeX向けの簡易設定。
% \andika 自体は pLaTeX で和文フォントも切り替えるため、
% \romanfamily で欧文フォントだけを指定する。
\newcommand{\UseAndikaForEnglish}{%
  \@ifundefined{andikafamily}{%
    \PackageError{lotusmath-english}%
      {Andika is not loaded}%
      {Load it with \string\usepackage{andika} before lotusmath.}%
  }{%
    \SetEngFont{\romanfamily{\andikafamily}\selectfont}%
  }%
}

% 通常サイズの英語と、問題文用の大きな英文。
% 長文でも改行できるよう、箱には入れない。
\newcommand{\EngText}[1]{{\LMEngTextFont #1}}
\newcommand{\EngSentence}[1]{{\large\LMEngTextFont #1}}

% 疑問文と返答を同じ文字サイズで並べる。各文・語群の途中で折り返せる。
\newcommand{\EngDialogue}[2]{%
  \EngSentence{#1}\enspace---\enspace\EngSentence{#2}%
}

% 解答で語句を丸で囲む。内容の幅に応じた楕円を本文の基線にそろえる。
\newsavebox{\LMEngCircleBox}
\newlength{\LMEngCircleWidth}
\newlength{\LMEngCircleHeight}
\newlength{\LMEngCircleX}
\newlength{\LMEngCircleY}
\newcommand{\EngCircle}[1]{%
  \begingroup
    \sbox{\LMEngCircleBox}{\EngText{#1}}%
    \setlength{\LMEngCircleWidth}{\dimexpr\wd\LMEngCircleBox+4pt\relax}%
    \setlength{\LMEngCircleHeight}{\dimexpr\ht\LMEngCircleBox+\dp\LMEngCircleBox+4pt\relax}%
    \setlength{\LMEngCircleX}{0.5\LMEngCircleWidth}%
    \setlength{\LMEngCircleY}{\dimexpr\ht\LMEngCircleBox-\dp\LMEngCircleBox\relax}%
    \divide\LMEngCircleY by 2\relax
    \setlength{\unitlength}{1pt}%
    \raisebox{0pt}[\dimexpr\ht\LMEngCircleBox+2pt\relax][\dimexpr\dp\LMEngCircleBox+2pt\relax]{%
      \begin{picture}(\strip@pt\LMEngCircleWidth,0)%
        \thinlines
        \put(\strip@pt\LMEngCircleX,\strip@pt\LMEngCircleY){%
          \oval(\strip@pt\LMEngCircleWidth,\strip@pt\LMEngCircleHeight)}%
        \put(2,0){\usebox{\LMEngCircleBox}}%
      \end{picture}%
    }%
  \endgroup
}

% 選択肢・並べ替え語群・補充用空欄。
% 外側の括弧は本文の書体、英語の中身だけを英文用書体にする。
% 区切り記号や語順は教材側で明示し、内容を不用意に解釈しない。
\newcommand{\EngChoice}[1]{%
  \begingroup\normalfont(\,\EngText{#1}\,)\endgroup
}
\newcommand{\EngReorder}[1]{%
  \begingroup\normalfont[\,\EngText{#1}\,]\endgroup
}
\newcommand{\EngBlank}[1][20mm]{%
  \leavevmode\rule[-0.5ex]{#1}{0.35pt}%
}

% 英字練習用の4本罫1段。3本目を基線として少し太くする。
\newcommand{\LMEngRuledBand}{%
  \par\vspace{\LMEngRuledTopSpace}%
  \noindent
  \vbox to \LMEngWritingLineHeight{%
    \hsize=\linewidth
    {\color{LMEngGuideLight}%
     \hrule width \linewidth height \LMEngGuideRuleThickness}%
    \vfil
    {\color{LMEngGuideLight}%
     \hrule width \linewidth height \LMEngGuideRuleThickness}%
    \vfil
    {\color{LMEngGuideBase}%
     \hrule width \linewidth height \LMEngBaseRuleThickness}%
    \vfil
    {\color{LMEngGuideLight}%
     \hrule width \linewidth height \LMEngGuideRuleThickness}%
  }%
  \par\vspace{\LMEngRuledBottomSpace}%
}

% 英文を書かせるための4本罫。省略可能引数は段数。
\newcommand{\EngRuledLines}[1][1]{%
  \par
  \begingroup
    \@tempcnta=0\relax
    \loop\ifnum\@tempcnta<#1\relax
      \advance\@tempcnta by 1\relax
      \LMEngRuledBand
    \repeat
  \endgroup
}

% 従来名との互換用。英語の記述欄は4本罫を標準にする。
\newcommand{\EngWritingLines}[1][1]{%
  \EngRuledLines[#1]%
}

% 短い英文を2回書くため、4本罫1段を中央で分けて左右に置く。
\newcommand{\EngSplitRuledLine}{%
  \par\noindent
  \begin{minipage}[t]{\dimexpr0.5\linewidth-0.5\LMEngSplitGap\relax}%
    \EngRuledLines[1]%
  \end{minipage}%
  \hspace{\LMEngSplitGap}%
  \begin{minipage}[t]{\dimexpr0.5\linewidth-0.5\LMEngSplitGap\relax}%
    \EngRuledLines[1]%
  \end{minipage}%
  \par
}

% 和訳など、英字の4本罫を必要としない記述欄。
\newcommand{\EngAnswerLines}[1][1]{%
  \par
  \begingroup
    \@tempcnta=0\relax
    \loop\ifnum\@tempcnta<#1\relax
      \advance\@tempcnta by 1\relax
      \vspace{\LMEngAnswerLineHeight}%
      \noindent\leaders\hrule height 0.35pt\hfill\kern0pt\par
    \repeat
  \endgroup
}

% 英文と和訳を解答欄に2行で表示する。
\newcommand{\EngAnswerPair}[2]{%
  \parbox[t]{\linewidth}{%
    \raggedright
    \EngText{#1}\par
    \vspace{2mm}%
    #2\par
  }%
}

% 記述欄つきの標準小問。第1引数は省略可能で、記述欄の行数。
\newcommand{\EngWriteQuestion}[3][1]{%
  \QQTall{#2\EngRuledLines[#1]}{\EngText{#3}}%
}

% 短い英文を左右に1回ずつ、計2回書かせる小問。
\newcommand{\EngWriteQuestionSplit}[2]{%
  \QQTall{#1\EngSplitRuledLine}{\EngText{#2}}%
}

% 英文を書き写す基本問題。第1引数は省略可能で、書写欄の行数。
\newcommand{\EngCopy}[2][1]{%
  \QQTall{%
    \EngSentence{#2}\par
    \vspace{1mm}%
    {\small 書写}%
    \EngRuledLines[#1]%
  }{\EngText{#2}}%
}

% 英文を書き写して和訳する問題。第1引数は省略可能で、書写欄の行数。
\newcommand{\EngCopyTranslate}[3][1]{%
  \QQTall{%
    \EngSentence{#2}\par
    \vspace{1mm}%
    {\small 書写}%
    \EngRuledLines[#1]%
    \vspace{-3mm}%
    {\small 和訳}%
    \EngAnswerLines[1]%
  }{\EngAnswerPair{#2}{#3}}%
}

% 短い英文向け。書写欄と和訳欄を左右に並べ、1段に収める。
\newcommand{\EngCopyTranslateSplit}[2]{%
  \QQTall{%
    \EngSentence{#1}\par
    \noindent
    \begin{minipage}[t]{\dimexpr0.5\linewidth-0.5\LMEngSplitGap\relax}%
      \vspace{0pt}%
      {\small 書写}%
      \EngRuledLines[1]%
    \end{minipage}%
    \hspace{\LMEngSplitGap}%
    \begin{minipage}[t]{\dimexpr0.5\linewidth-0.5\LMEngSplitGap\relax}%
      \vspace{0pt}%
      {\small 和訳}%
      \EngAnswerLines[1]%
    \end{minipage}%
    \par
  }{\EngAnswerPair{#1}{#2}}%
}

% 応答を選び、疑問文と選んだ返答を日本語に訳す。
% #1: 和訳欄の行数（既定1）、#2: 疑問文、#3: 記号つき選択肢、#4: 解答。
% 余分な段落間隔は置かず、和訳欄には既存の和文用行高を使う。
\newcommand{\EngResponseChoice}[4][1]{%
  \QQTall{%
    \EngSentence{#2}\par
    {\large\raggedright #3\par}%
    \EngAnswerLines[#1]%
  }{#4}%
}

% ===== 英語解答の自動段送り（親TeXで明示的に有効化） =====

\newif\ifLMEngAutoAnswers
\LMEngAutoAnswersfalse
\newcommand{\UseEnglishAutoAnswers}{\LMEngAutoAnswerstrue}
\newcommand{\UseStandardAnswers}{\LMEngAutoAnswersfalse}

\newif\ifLMEngPendingAnswerHeading
\newsavebox{\LMEngAnswerHeadingBox}
\newsavebox{\LMEngAutoAnswerBox}

% テーマ全体を箱にしない。テーマ番号は各大問の見出しに併記する。
\newcommand{\LMEngAutoMajorQuestion}[1]{%
  \ResetRowSpace
  \LMAfterTypeQuestionfalse
  \stepcounter{LMmajor}%
  \setcounter{LMtype}{0}%
  \setcounter{LMsubq}{0}%
  \LMInstructionUsedfalse
  \LMWrapModefalse
}

% 見出しは保留し、最初の小問と一つの箱にして段末の孤立を防ぐ。
\newcommand{\LMEngAutoTypeQuestion}[2]{%
  \LMAfterTypeQuestionfalse
  \stepcounter{LMtype}%
  \setcounter{LMsubq}{0}%
  \LMInstructionUsedtrue
  \sbox{\LMEngAnswerHeadingBox}{%
    \begin{minipage}{\linewidth}%
      \noindent\LMBoxedMajor\hspace{2mm}\LMBoxedTypeQuestionAns\par
      \vspace{4mm}%
    \end{minipage}%
  }%
  \LMEngPendingAnswerHeadingtrue
}

% 小問ごとに箱を作る。英文＋和訳／疑問文＋返答の組も途中分割しない。
% 解答は測定のため再実行せず、一度だけ組版する。
\newcommand{\LMEngAutoAnswerQuestion}[2]{%
  \LMAfterTypeQuestionfalse
  \stepcounter{LMsubq}%
  \par
  \sbox{\LMEngAutoAnswerBox}{%
    \begin{minipage}{\linewidth}%
      \ifLMEngPendingAnswerHeading
        \vspace{2mm}%
        \noindent\usebox{\LMEngAnswerHeadingBox}\par
      \fi
      \noindent\makebox[9mm][l]{\textbf{(\theLMsubq)}}%
      \parbox[t]{\dimexpr\linewidth-9mm\relax}{%
        \raggedright
        #2\par
      }%
      \par
    \end{minipage}%
  }%
  \noindent\usebox{\LMEngAutoAnswerBox}\par
  \LMEngPendingAnswerHeadingfalse
  \vspace{\LMAnswerRowSpace}%
}

\newcommand{\LMEngAutoAnswerQ}[3]{\LMEngAutoAnswerQuestion{#1}{#2}}

\newcommand{\LMEngPrintAutoAnswers}{%
  \clearpage
  \begingroup
    \LMAnswerModetrue
    \setcounter{LMmajor}{0}%
    \setcounter{LMtype}{0}%
    \setcounter{LMsubq}{0}%
    \LMInstructionUsedfalse
    \LMWrapModefalse
    \LMInAnswerBlockfalse
    \LMEngPendingAnswerHeadingfalse
    % 再読込中だけ差し替える。問題側・通常解答モードには影響しない。
    \let\MajorQuestionLesson\LMEngAutoMajorQuestion
    \let\MajorQuestion\LMEngAutoMajorQuestion
    \let\TypeQuestion\LMEngAutoTypeQuestion
    \let\QQ\LMEngAutoAnswerQuestion
    \let\QQTall\LMEngAutoAnswerQuestion
    \let\Q\LMEngAutoAnswerQ
    \renewcommand{\LessonPageBreak}{\LMAfterTypeQuestionfalse}%
    % 明示的な解答専用の段切り・改ページは残す。
    \renewcommand{\AnswerColumnBreak}{\par\columnbreak}%
    \renewcommand{\LMQueuedAnswerPageBreak}{%
      \end{multicols*}\clearpage
      \begin{multicols*}{2}\raggedcolumns
    }%
    \begin{center}
      {\Large \LMCoverTitle}\par
      \vspace{1mm}%
      {\normalsize \LMCoverSubtitle}\par
    \end{center}
    \vspace{3mm}%
    % 星付きでは最終ページも均等化せず、左→右→次ページの順で埋める。
    \begin{multicols*}{2}
      \raggedcolumns
      \LMProblemList
    \end{multicols*}
    \clearpage
  \endgroup
}

\let\LMEngStandardPrintAnswers\PrintAnswers
\renewcommand{\PrintAnswers}{%
  \ifLMEngAutoAnswers
    \LMEngPrintAutoAnswers
  \else
    \LMEngStandardPrintAnswers
  \fi
}

% ===== ワードバンク =====

% \WordBank で登録された各テーマのワードバンクを、登録順に蓄積する。
\newcommand{\LMWordBankList}{}

\newcommand{\LMResetWordBanks}{%
  \global\let\LMWordBankList\@empty
}

% 同じ文書で \BeginQuestions を再度使う場合にも、以前の登録を残さない。
\g@addto@macro\BeginQuestions{\LMResetWordBanks}

% #1: テーマ名、#2: \WB の列
% 現在のテーマ番号を値として固定し、問題ファイル再読込時の変化を受けないようにする。
\newcommand{\WordBank}[2]{%
  \ifLMAnswerMode
  \else
    \begingroup
      \edef\LMStoredWordBankTheme{\LMCurrentTheme}%
      \xdef\LMWordBankList{%
        \unexpanded\expandafter{\LMWordBankList}%
        \noexpand\LMPrintWordBankBlock
          {\LMStoredWordBankTheme}%
          {\unexpanded{#1}}%
          {\unexpanded{#2}}%
      }%
    \endgroup
  \fi
}

% ワードバンク1行。
% #1: 単語・熟語、#2: 品詞、#3: 意味、#4: 変化形・注意
\newcommand{\WB}[4]{%
  \EngText{#1} & #2 & #3 & #4\\\hline
}

\newcommand{\LMWordBankThemeBox}[1]{%
  {\setlength{\fboxsep}{1.5mm}\fcolorbox{black}{LMBoxGray}{\strut #1}}%
}

\newsavebox{\LMWordBankPageBox}

% 各テーマは独立した1ページ。表を分割せず、収まりきらなければ通知する。
\newcommand{\LMPrintWordBankBlock}[3]{%
  \clearpage
  \sbox{\LMWordBankPageBox}{%
    \begin{minipage}{\linewidth}%
      \begin{center}
        {\Large ワードバンク}\par
        \vspace{1mm}%
        {\normalsize \LMCoverTitle}\par
      \end{center}
      \vspace{2mm}%
      \noindent\LMWordBankThemeBox{#1}\hspace{2mm}{\large #2}\par
      \vspace{2mm}%
    \small
    \hbadness=10000\relax
    \setlength{\tabcolsep}{1.5mm}%
    \setlength{\arrayrulewidth}{0.3pt}%
    \renewcommand{\arraystretch}{1.00}%
    \noindent\begin{tabular}{%
      @{}>{\raggedright\arraybackslash}p{0.21\linewidth}
      >{\raggedright\arraybackslash}p{0.11\linewidth}
      >{\raggedright\arraybackslash}p{0.28\linewidth}
      >{\raggedright\arraybackslash}p{0.30\linewidth}@{}}
      \hline
      \textbf{単語・熟語} & \textbf{品詞} & \textbf{意味} & \textbf{変化形・注意}\\\hline
      #3
    \end{tabular}\par
    \end{minipage}%
  }%
  \ifdim\dimexpr\ht\LMWordBankPageBox+\dp\LMWordBankPageBox\relax>\textheight
    \PackageError{lotusmath-english}{Word bank #1 exceeds one page}%
      {Shorten notes or combine inflected forms in this theme's word bank.
       The table is not reduced to unreadably small text.}%
  \fi
  \noindent\usebox{\LMWordBankPageBox}\par
}

% 登録済みワードバンクを問題と解答の間にまとめて出力する。
% 1件も登録されていない場合は、改ページも見出しも出さない。
\newcommand{\PrintWordBanks}{%
  \ifx\LMWordBankList\@empty
  \else
    \LMWordBankList
  \fi
}

% ===== フレーズバンク =====

% 完成した英文と和訳を、ワードバンクとは別にテーマ順で蓄積する。
\newcommand{\LMPhraseBankList}{}
\newcommand{\LMResetPhraseBanks}{%
  \global\let\LMPhraseBankList\@empty
}
\g@addto@macro\BeginQuestions{\LMResetPhraseBanks}

% #1: テーマ名、#2: \PB の列。解答用の再読込では登録しない。
\newcommand{\PhraseBank}[2]{%
  \ifLMAnswerMode
  \else
    \begingroup
      \edef\LMStoredPhraseBankTheme{\LMCurrentTheme}%
      \xdef\LMPhraseBankList{%
        \unexpanded\expandafter{\LMPhraseBankList}%
        \noexpand\LMPrintPhraseBankBlock
          {\LMStoredPhraseBankTheme}%
          {\unexpanded{#1}}%
          {\unexpanded{#2}}%
      }%
    \endgroup
  \fi
}

% #1: 完成した英文（短い答えを含む）、#2: 和訳。
% 星付きは次の例文と同じページに保つ（疑問文と返答の組向け）。
\newcommand{\PB}{\@ifstar{\LMPBKeepNext}{\LMPBRow}}
\newcommand{\LMPBRow}[2]{%
  \EngText{#1} & #2\\\hline
}
\newcommand{\LMPBKeepNext}[2]{%
  % longtable の \hline 自体に改ページ候補があるため、
  % 星付きの行では通常の罫線を引き、次の行まで改ページを禁止する。
  \EngText{#1} & #2\\*%
  \noalign{\hrule height \arrayrulewidth\penalty10000}%
}

\newcommand{\LMPrintPhraseBankBlock}[3]{%
  \Needspace{45mm}%
  \par\vspace{3mm}%
  \noindent\LMWordBankThemeBox{#1}\hspace{2mm}{\large #2}\par
  \vspace{1mm}%
  \begingroup
    \normalsize
    \setlength{\tabcolsep}{1.5mm}%
    \setlength{\arrayrulewidth}{0.3pt}%
    \renewcommand{\arraystretch}{1.4}%
    \setlength{\LTleft}{0pt}%
    \setlength{\LTright}{0pt}%
    \begin{longtable}{%
      @{}>{\raggedright\arraybackslash}p{\dimexpr0.5\linewidth-1.5mm\relax}
      >{\raggedright\arraybackslash}p{\dimexpr0.5\linewidth-1.5mm\relax}@{}}
      \hline
      \textbf{英文} & \textbf{日本語訳}\\\hline
      \endfirsthead
      \hline
      \textbf{英文} & \textbf{日本語訳}\\\hline
      \endhead
      #3
    \end{longtable}%
  \endgroup
}

% ワードバンクの後・解答の前に呼ぶ。未登録なら改ページもしない。
\newcommand{\PrintPhraseBanks}{%
  \ifx\LMPhraseBankList\@empty
  \else
    \clearpage
    \begin{center}
      {\Large フレーズバンク}\par
      \vspace{1mm}%
      {\normalsize \LMCoverTitle}\par
    \end{center}
    \vspace{2mm}%
    \LMPhraseBankList
  \fi
}

\makeatother
